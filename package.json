{
  "name": "engineering-job-market",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "bun test apps packages",
    "migrate": "bun run --cwd apps/collector migrate",
    "collect": "bun run --cwd apps/collector collect"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  }
}
