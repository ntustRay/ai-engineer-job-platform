{
  "name": "engineering-job-market",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "bun test apps packages",
    "migrate": "bun apps/collector/src/cli.ts migrate",
    "collect": "bun apps/collector/src/cli.ts collect",
    "db:account": "bun apps/web/lib/account-migrate.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "playwright": "1.64.1",
    "typescript": "7.0.2"
  }
}
